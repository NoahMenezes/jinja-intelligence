{
  "name": "jinja-intelligence",
  "version": "0.6.0",
  "description": "Python-aware, project-aware Language Server for Jinja templates",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "jinja-intelligence": "dist/server.js"
  },
  "scripts": {
    "dev": "bun src/server.ts --stdio",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js --stdio"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.8",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
