{
  "name": "jinja-intelligence-vscode",
  "version": "1.0.0",
  "displayName": "Jinja Intelligence",
  "description": "Python-aware, project-aware language intelligence for Jinja templates",
  "license": "MIT",
  "publisher": "NoahMenezes",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoahMenezes/jinja-intelligence.git",
    "directory": "editors/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["jinja", "jinja2", "templates", "flask", "django", "lsp"],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json && node scripts/copy-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "package": "vsce package"
  },
  "activationEvents": [
    "onLanguage:jinja",
    "onLanguage:jinja2",
    "workspaceContains:**/*.j2",
    "workspaceContains:**/*.jinja"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jinja",
        "aliases": ["Jinja", "jinja2"],
        "extensions": [".j2", ".jinja", ".jinja2"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Jinja Intelligence",
      "properties": {
        "jinjaIntelligence.templateDirectories": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra template lookup directories: absolute paths or workspace-relative."
        },
        "jinjaIntelligence.templateExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".jinja", ".jinja2", ".j2"],
          "description": "Template file extensions scanned by the project index."
        },
        "jinjaIntelligence.maxLogLines": {
          "type": "number",
          "default": 500,
          "description": "Maximum retained log lines."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
